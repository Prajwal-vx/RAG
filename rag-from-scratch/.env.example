# Embeddings run locally by default
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM options: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# For Ollama instead:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
