# Embeddings model (runs locally offline by default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider Options: mock | openai | ollama
# 'mock' provides fully grounded, deterministic offline generation with zero API cost
LLM_PROVIDER=mock

# For OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# For Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Retrieval Configuration
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RERANK_ENABLED=true
HYBRID_WEIGHT_SEMANTIC=0.65
HYBRID_WEIGHT_LEXICAL=0.35
